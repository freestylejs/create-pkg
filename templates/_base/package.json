{
    "name": "__PROJECT_NAME__",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "__DESCRIPTION__",
    "keywords": [],
    "author": "__AUTHOR__",
    "license": "__LICENSE__",
    "repository": {
        "type": "git",
        "url": "git+__REPO_URL__.git"
    },
    "bugs": {
        "url": "__REPO_URL__/issues"
    },
    "homepage": "__REPO_URL__#readme",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
        "pnpm": ">=10.20.0"
    },
    "scripts": {
        "dev": "turbo run build && turbo run dev",
        "build": "pnpm reset:dist && turbo run build --no-cache --force",
        "build:fast": "pnpm reset:dist && turbo run build:fast",
        "start": "turbo run start",
        "test": "vitest",
        "test:watch": "vitest --watch -u",
        "test:coverage": "vitest run --coverage",
        "test:ci": "pnpm sync:check && pnpm build && pnpm check && pnpm test:coverage",
        "sync:toolchain": "node scripts/sync-toolchain.mjs --write",
        "sync:check": "node scripts/sync-toolchain.mjs --check",
        "verify:package": "pnpm build && publint packages/__PACKAGE_DIR__ && attw --pack packages/__PACKAGE_DIR__ && node scripts/verify-package.mjs",
        "ts:typecheck": "turbo run ts:typecheck",
        "ts:perf": "rimraf ts-perf && tsc --noEmit --generateTrace ts-perf",
        "lint": "oxlint --fix --deny-warnings",
        "format": "oxfmt .",
        "check": "oxlint --deny-warnings && oxfmt --check .",
        "report": "oxlint --deny-warnings",
        "reset:turbo": "turbo run clean",
        "reset:dist": "pnpm -r --parallel exec rimraf dist .turbo",
        "reset:modules": "pnpm -r --parallel exec rimraf node_modules && rimraf node_modules .turbo",
        "reset": "pnpm reset:dist && pnpm reset:modules",
        "pkg:init": "pnpm test:ci && changeset",
        "pkg:version": "changeset version",
        "pkg:publish": "changeset publish",
        "pre-commit": "lint-staged"
    },
    "packageManager": "pnpm@__VERSION_PNPM__",
    "devDependencies": {
        "@arethetypeswrong/cli": "__VERSION_ATTW__",
        "@changesets/cli": "__VERSION_CHANGESETS__",
        "@freestylejs/config": "__VERSION_CONFIG__",
        "@types/node": "__VERSION_TYPES_NODE__",
        "@vitest/coverage-v8": "__VERSION_COVERAGE_V8__",
        "husky": "__VERSION_HUSKY__",
        "lint-staged": "__VERSION_LINT_STAGED__",
        "oxfmt": "__VERSION_OXFMT__",
        "oxlint": "__VERSION_OXLINT__",
        "publint": "__VERSION_PUBLINT__",
        "rimraf": "__VERSION_RIMRAF__",
        "tsdown": "__VERSION_TSDOWN__",
        "turbo": "__VERSION_TURBO__",
        "typescript": "__VERSION_TYPESCRIPT__",
        "vite": "__VERSION_VITE__",
        "vitest": "__VERSION_VITEST__"
    }
}
